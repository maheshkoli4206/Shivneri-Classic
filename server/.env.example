# ===================================================================
# SHIVNERI CLASSIC APARTMENT - ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================================
# Copy this file to .env and configure your values.
# NEVER commit the real .env file into Git.

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (Target Isolated Database: shivneri_classic_admin_db)
# Atlas Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shivneri_classic_admin_db?retryWrites=true&w=majority
# Local Example: mongodb://localhost:27017/shivneri_classic_admin_db
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shivneri_classic_admin_db?retryWrites=true&w=majority

# JWT Authentication (Secured via HttpOnly, Secure, SameSite Cookies)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_here
JWT_EXPIRES_IN=8h

# Admin Initial Provisioning (Used strictly by seedAdmin.js script)
ADMIN_INITIAL_USERNAME=admin_username_here
ADMIN_INITIAL_PASSWORD=AdminSecurePass@2026

# Society Metadata
SOCIETY_NAME_MARATHI="शिवनेरी क्लासिक अपार्टमेंट"
SOCIETY_WING="A Wing"
SOCIETY_LOCATION="औरंगाबाद रोड, पंचवटी, नाशिक"
