# ==============================================================================
# 🏛️ SHIVNERI CLASSIC APARTMENT - VERCEL CLOUD DEPLOYMENT ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy these environment variables into your Vercel Project Settings:
# Vercel Dashboard -> Project -> Settings -> Environment Variables
# ==============================================================================

# Node Environment
NODE_ENV=production

# Online Cloud Database (MongoDB Atlas)
# Replace with your actual MongoDB Atlas connection string:
# Format: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/shivneri_classic_prod_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shivneri_classic_prod_db?retryWrites=true&w=majority

# Or alternatively (both are supported):
# DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shivneri_classic_prod_db?retryWrites=true&w=majority

# JWT Authentication Secret (Minimum 32 characters, random strong secret)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_here
JWT_EXPIRES_IN=8h

# Client Allowed Origin (Optional in unified deployment; automatically trusted on Vercel)
# CLIENT_ORIGIN=https://your-project.vercel.app

# Society Metadata
SOCIETY_NAME_MARATHI="शिवनेरी क्लासिक अपार्टमेंट"
SOCIETY_WING="A Wing"
SOCIETY_LOCATION="औरंगाबाद रोड, पंचवटी, नाशिक"

